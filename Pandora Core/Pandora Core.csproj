<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Pandora.Core</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>
		<PackageId>Pandora.Core</PackageId>
		<GenerateAssemblyInformationalVersionAttribute>true</GenerateAssemblyInformationalVersionAttribute>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Pandora Tests" />
		<InternalsVisibleTo Include="Pandora Skyrim" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="GameFinder" Version="4.9.0" />
		<PackageReference Include="GameFinder.StoreHandlers.GOG" Version="4.9.0" />
		<PackageReference Include="GameFinder.StoreHandlers.Steam" Version="4.9.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
		<PackageReference Include="NLog" Version="6.0.7" />
		<PackageReference Include="NexusMods.Paths" Version="0.19.1" />
		<PackageReference Include="System.CommandLine" Version="2.0.1" />
		<PackageReference Include="System.Reactive" Version="6.0.1" />
		<PackageReference Include="Testably.Abstractions" Version="10.0.0" />
		<PackageReference Include="Vanara.PInvoke.NtDll" Version="4.2.1" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Pandora API\Pandora API\Pandora API.csproj" />
	</ItemGroup>
</Project>
